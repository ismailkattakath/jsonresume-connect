{
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash"
          },
          "claude": {
            "args": [
              "-lc",
              "exec nix develop github:kattakath/nix-config#fleet -c claude"
            ],
            "icon": "claude",
            "path": "bash"
          },
          "nix develop": {
            "args": [
              "-lc",
              "exec nix develop"
            ],
            "icon": "beaker",
            "path": "bash"
          }
        }
      }
    }
  },
  "image": "ghcr.io/kattakath/devcontainer:1",
  "name": "jsonresume-connect",
  "postCreateCommand": "direnv allow ${containerWorkspaceFolder}",
  "postStartCommand": "git -C / config --global --add safe.directory ${containerWorkspaceFolder}",
  "workspaceFolder": "/workspaces/jsonresume-connect",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/jsonresume-connect,type=bind"
}
