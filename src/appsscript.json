{
  "timeZone": "Etc/UTC",
  "exceptionLogging": "STACKDRIVER",
  "runtimeVersion": "V8",
  "oauthScopes": [
    "https://www.googleapis.com/auth/script.external_request",
    "https://www.googleapis.com/auth/drive.file"
  ],
  "dependencies": {
    "enabledAdvancedServices": [
      {
        "serviceId": "drive",
        "userSymbol": "Drive",
        "version": "v3"
      },
      {
        "serviceId": "docs",
        "userSymbol": "Docs",
        "version": "v1"
      }
    ]
  },
  "urlFetchWhitelist": [
    "https://www.googleapis.com/",
    "https://docs.googleapis.com/",
    "https://jsonresume.org/"
  ],
  "addOns": {
    "common": {
      "name": "JSON Resume Connect",
      "logoUrl": "https://raw.githubusercontent.com/ismailkattakath/jsonresume-connect/58ecc75d795a15e689165d59529eba34a6beb4e0/assets/icon-128.png"
    },
    "flows": {
      "workflowElements": [
        {
          "id": "jsonResumeToDoc",
          "state": "ACTIVE",
          "name": "JSON Resume Connect",
          "description": "Loads your resume from your JSON Resume account (Connect JSON Resume), checks it against the jsonresume.org schema, and renders it as a document for Google Docs™ in your Drive, with PDF and DOCX download links. It can only see the files it creates.",
          "workflowAction": {
            "inputs": [
              {
                "id": "title",
                "description": "Document title",
                "cardinality": "SINGLE",
                "required": false,
                "dataType": {
                  "basicType": "STRING"
                }
              }
            ],
            "outputs": [
              {
                "id": "docUrl",
                "description": "Link to doc",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "docName",
                "description": "Doc name",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "pdfUrl",
                "description": "Link to PDF",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "docxUrl",
                "description": "Link to DOCX",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "docId",
                "description": "Document ID",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "name",
                "description": "Name",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "label",
                "description": "Headline",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "email",
                "description": "Email address",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "resumeText",
                "description": "Resume (plain text)",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              },
              {
                "id": "resume",
                "description": "Resume (JSON)",
                "cardinality": "SINGLE",
                "dataType": {
                  "basicType": "STRING"
                }
              }
            ],
            "onConfigFunction": "onConfigJsonResumeToDoc",
            "onExecuteFunction": "onExecuteJsonResumeToDoc"
          }
        }
      ]
    }
  }
}
